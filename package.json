{
  "name": "autoservice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.sw.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-db.mjs",
    "studio:new": "node scripts/studio-new.mjs",
    "studio:push": "node --experimental-strip-types scripts/studio-push.ts",
    "functions:sync": "node scripts/sync-functions.mjs",
    "functions:deploy": "node scripts/sync-functions.mjs && supabase functions deploy",
    "studio:schema": "node --experimental-strip-types scripts/build-schema.ts",
    "studio:images": "node scripts/generate-demo-images.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.5",
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "^0.19.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/query-sync-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "liquid-gl": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "openai": "^7.30.0",
    "sharp": "^0.35.5",
    "supabase": "^2.120.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1"
  },
  "engines": {
    "node": ">=22.6"
  }
}
