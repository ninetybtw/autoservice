# ── Приложение (Vercel → Settings → Environment Variables) ─────────────────
# Без этих двух переменных приложение работает в демо-режиме (данные в браузере).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>
# Публичный VAPID-ключ для push-напоминаний (npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
# Необязательно: куда вести с корня сайта (обычно не нужно — у каждой студии своя ссылка)
VITE_DEFAULT_STUDIO=

# ── Скрипт pnpm studio:push (только на вашем компьютере, не в Vercel!) ─────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>
APP_URL=https://<your-app>.vercel.app

# ── Секреты серверных функций Supabase (supabase secrets set ...) ──────────
# OPENAI_API_KEY=sk-...          без ключа работает встроенный помощник без модели
# OPENAI_MODEL=gpt-5-mini        модель меняется здесь, без пересборки приложения
# OPENAI_BASE_URL=               необязательно, для совместимых API
# VAPID_PUBLIC_KEY=  VAPID_PRIVATE_KEY=  VAPID_SUBJECT=mailto:you@example.com
# CRON_SECRET=<случайная строка>  APP_URL=https://<your-app>.vercel.app
